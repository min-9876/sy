import asyncio, os, yt_dlp
from typing import Union

# --- ဒီနေရာမှာ သင့်ရဲ့ Cookies စာသား အရှည်ကြီးကို ထည့်ပါ ---
MY_COOKIES_TEXT = """
# Netscape HTTP Cookie File
.youtube.com	TRUE	/	TRUE	1749876543	... (သင့် cookies စာသားများကို ဒီမှာ ကူးထည့်ပါ)
"""
# ----------------------------------------------------

class YouTubeAPI:
    # ... (အခြား method များ) ...

    async def download(self, link, mystic, video=None, **kwargs) -> str:
        # Code ထဲက Cookies ကို Temporary file အဖြစ် ခဏဖန်တီးမယ်
        cookie_path = "cookies_temp.txt"
        with open(cookie_path, "w") as f:
            f.write(MY_COOKIES_TEXT)

        loop = asyncio.get_running_loop()
        def direct_download():
            ydl_opts = {
                "format": "bestvideo+bestaudio/best" if video else "bestaudio/best",
                "outtmpl": "downloads/%(id)s.%(ext)s",
                "cookiefile": cookie_path, # ဖန်တီးထားတဲ့ file ကို သုံးမယ်
                "quiet": True,
            }
            with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                info = ydl.extract_info(link, download=True)
                return os.path.join("downloads", f"{info['id']}.{info['ext']}")

        try:
            downloaded_file = await loop.run_in_executor(None, direct_download)
            return downloaded_file, False
        except Exception as e:
            print(f"Error: {e}")
            return None, False
        finally:
            if os.path.exists(cookie_path):
                os.remove(cookie_path) # အလုပ်ပြီးရင် ဖိုင်ကို ဖျက်ပေးမယ်
